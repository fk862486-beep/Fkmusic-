<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>FK AI Control Center</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<body>
<div x-data="{ open: false }">
    <button @click="open = !open">
        Alpine.js Test
    </button>

    <p x-show="open">
        ✅ Alpine.js Working!
    </p>
</div>

<div class="sidebar">

<div class="logo">
🤖 FK AI
</div>

<div class="menu">
<a href="/admin">🏠 Dashboard</a>
<a href="#">🤖 AI Control</a>
<a href="#">🎵 Music</a>
<a href="#">👥 Members</a>
<a href="#">🛡 Admins</a>
<a href="#">📊 Analytics</a>
<a href="#">⚙ Settings</a>
<a href="/logout">🚪 Logout</a>
</div>

</div>


<div class="main">

<h1>FK AI Control Center</h1>
<p>
👤 <%= user || "Admin" %>
|
👑 <%= role || "ADMIN" %>
</p>

<div class="cards">


<div class="card">
<h2>🤖 Bot Status</h2>
<p class="status">
🤖 <%= botStatus %>
</p>
</div>


<div class="card">
<h2>🎵 Music</h2>

<p>
Status: 🎵 <%= musicStatus %>
</p>

<p>
🎧 Current Song:
<%= music.currentSong %>
</p>

<p>
📃 Queue:
</p>

<ul>
<% music.queue.forEach(function(song){ %>

<li>
🎵 <%= song %>
</li>

<% }) %>
</ul>

</div>


<div class="card">
<h2>👥 Members</h2>
<p>
<%= totalUsers %> Members
</p>

<ul>
<% users.forEach(function(user){ %>

<li>
👤 <%= user %>
</li>

<% }) %>
</ul>

</div>


<div class="card">
<h2>📊 Analytics</h2>
<p>
Coming Soon
</p>
</div>



<div class="card">
<h2>🤖 Bot Control</h2>

<p>
Current Status:
<b><%= botStatus %></b>
</p>


<a href="/bot-on">
<button>🟢 Turn Bot ON</button>
</a>

<a href="/bot-off">
<button>🔴 Turn Bot OFF</button>
</a>

<br><br>

<a href="/control/music-on">
<button>🎵 Music ON</button>
</a>

<a href="/control/music-off">
<button>🔇 Music OFF</button>
</a>

</div>


<a href="/control/music-on">
<button>🎵 Music ON</button>
</a>

<a href="/control/music-off">
<button>🔇 Music OFF</button>
</a>

</div>



<div class="card">

<h2>💬 Chat History</h2>


<% if(chats && chats.length > 0){ %>


<% chats.forEach(function(chat){ %>

<div class="chat-box">

<p>
👤 <%= chat.name %>
</p>

<p>
💬 <%= chat.message %>
</p>

<p>
🤖 <%= chat.reply %>
</p>

<p>
🕒 <%= chat.time %>
</p>


</div>

<hr>


<% }) %>


<% } else { %>

<p>No Chat History</p>

<% } %>


</div>


</div>


</div>

</body>
</html>
